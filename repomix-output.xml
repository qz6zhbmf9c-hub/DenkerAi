<file path="api/review.js">
// POST /api/review  { cardId, rating: 1..4 }
// Applies the SM-2 scheduler, saves the card and writes a ReviewLog row.
import { prisma } from './_lib/db.js';
import { allowMethods, json, withUser } from './_lib/auth.js';
import { previewDelays, schedule } from './_lib/srs.js';

export default withUser(async (req, res, user) => {
  if (!allowMethods(req, res, ['POST'])) return;
  const cardId = String(req.body?.cardId || '');
  const rating = req.body?.rating;
  if (![1, 2, 3, 4].includes(rating)) return json(res, 400, { error: 'Rating must be 1 to 4.' });

  // The collection filter ensures the card belongs to this user.
  const card = await prisma.card.findFirst({ where: { id: cardId, collection: { userId: user.id } } });
  if (!card) return json(res, 404, { error: 'Card not found.' });

  const { delayMinutes, ...next } = schedule(card, rating, new Date());
  const [updated] = await prisma.$transaction([
    prisma.card.update({ where: { id: card.id }, data: next }),
    prisma.reviewLog.create({
      data: { userId: user.id, cardId: card.id, rating, prevState: card.state, newIntervalDays: next.intervalDays },
    }),
  ]);

  json(res, 200, {
    card: { id: updated.id, state: updated.state, due: updated.due, delayMinutes, delays: previewDelays(updated) },
  });
});
</file>

<file path="api/stats.js">
// GET /api/stats -> numbers for the three dashboard tiles.
import { prisma } from './_lib/db.js';
import { allowMethods, json, withUser } from './_lib/auth.js';
import { newStartedToday, summarize } from './_lib/queries.js';

export default withUser(async (req, res, user) => {
  if (!allowMethods(req, res, ['GET'])) return;
  const [collections, started] = await Promise.all([
    prisma.collection.findMany({
      where: { userId: user.id },
      include: { cards: { select: { state: true, due: true } } },
    }),
    newStartedToday(user.id),
  ]);

  let total = 0;
  let learned = 0;
  let due = 0;
  for (const c of collections) {
    const s = summarize(c.cards, started[c.id] || 0);
    total += s.total;
    learned += s.learned;
    due += s.due;
  }
  json(res, 200, {
    dueToday: due,
    wordsLearned: learned,
    progress: total ? Math.round((learned / total) * 100) : 0,
    collections: collections.length,
  });
});
</file>

<file path="api/study.js">
// GET /api/study?collectionId=ID -> today's queue in Anki order, plus counters.
// Each card carries `delays`: minutes until it returns for Again/Hard/Good/Easy.
import { prisma } from './_lib/db.js';
import { allowMethods, json, withUser } from './_lib/auth.js';
import { buildQueue, previewDelays } from './_lib/srs.js';
import { newStartedToday } from './_lib/queries.js';

export default withUser(async (req, res, user) => {
  if (!allowMethods(req, res, ['GET'])) return;
  const collectionId = String(req.query.collectionId || '');
  const collection = await prisma.collection.findFirst({
    where: { id: collectionId, userId: user.id },
    include: { cards: true },
  });
  if (!collection) return json(res, 404, { error: 'Collection not found.' });

  const started = (await newStartedToday(user.id))[collection.id] || 0;
  const queue = buildQueue(collection.cards, new Date(), started);

  json(res, 200, {
    collection: { id: collection.id, title: collection.title, level: collection.level },
    counts: {
      new: queue.filter((c) => c.state === 'new').length,
      learning: queue.filter((c) => c.state === 'learning' || c.state === 'relearning').length,
      review: queue.filter((c) => c.state === 'review').length,
    },
    cards: queue.map((c) => ({
      id: c.id,
      german: c.german,
      english: c.english,
      partOfSpeech: c.partOfSpeech,
      gender: c.gender,
      exampleDe: c.exampleDe,
      exampleEn: c.exampleEn,
      state: c.state,
      delays: previewDelays(c),
    })),
  });
});
</file>

<file path="prisma/schema.prisma">
// DenkerAI database schema (PostgreSQL via Neon or Vercel Postgres).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String       @id @default(cuid())
  name              String
  email             String       @unique
  passwordHash      String
  level             String?
  levelSource       String?
  privacyAcceptedAt DateTime
  createdAt         DateTime     @default(now())
  collections       Collection[]
  reviews           ReviewLog[]
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  prompt    String
  level     String
  createdAt DateTime @default(now())
  cards     Card[]

  @@index([userId])
}

model Card {
  id             String     @id @default(cuid())
  collectionId   String
  collection     Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  german         String
  english        String
  partOfSpeech   String
  gender         String?
  exampleDe      String
  exampleEn      String
  state          String     @default("new") // new | learning | review | relearning
  step           Int        @default(0)
  ease           Float      @default(2.5)
  intervalDays   Float      @default(0)
  due            DateTime   @default(now())
  reps           Int        @default(0)
  lapses         Int        @default(0)
  lastReviewedAt DateTime?
  reviews        ReviewLog[]

  @@index([collectionId, due])
}

model ReviewLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId          String
  card            Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating          Int
  prevState       String
  newIntervalDays Float
  reviewedAt      DateTime @default(now())

  @@index([userId, reviewedAt])
}
</file>

<file path="public/css/style.css">
/* DenkerAI design system. Tokens first, then base, components, page layouts. */
:root {
  --bg1: #0a1730; --bg2: #0d2550; --glow: rgba(46, 120, 220, .45);
  --green: #58cc02; --green-dark: #3f9a00; --green-light: #9cf04f;
  --navy: #0a1730; --text: #ffffff; --muted: #b9c7e6;
  --glass: rgba(255, 255, 255, .09); --glass-border: rgba(255, 255, 255, .22);
  --track: rgba(255, 255, 255, .16);
  --again: #ff7b7b; --hard: #ffc061; --good: #58cc02; --easy: #5cc0ff;
}

* { box-sizing: border-box; }

body {
  margin: 0; font-family: 'Nunito', sans-serif; color: var(--text); min-height: 100vh;
  background: radial-gradient(800px 460px at 85% -5%, var(--glow), transparent), linear-gradient(160deg, var(--bg1), var(--bg2));
  background-attachment: fixed; overflow-x: hidden;
  display: flex; flex-direction: column;
}
main { flex: 1; padding-bottom: 40px; }

/* ---------- Typography ---------- */
h1 { font-size: 50px; font-weight: 900; line-height: 1.08; margin: 0 0 16px; }
h2 { font-size: 38px; font-weight: 900; margin: 0 0 16px; }
h3 { font-size: 24px; font-weight: 900; margin: 0; }
p { margin: 0 0 16px; line-height: 1.5; }
a { color: #fff; }
.text-muted { color: var(--muted); }
.text-14 { font-size: 14px; } .text-18 { font-size: 18px; }
.w700 { font-weight: 700; } .w800 { font-weight: 800; } .w900 { font-weight: 900; }
.center { text-align: center; }

/* ---------- Focus ring (keyboard users) ---------- */
:focus-visible { outline: 3px solid var(--green-light); outline-offset: 3px; }
.input-glass:focus-visible { outline: none; }

/* ---------- Glass panel ---------- */
.glass-panel {
  background: var(--glass); border: 1px solid var(--glass-border);
  backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
  border-radius: 28px; box-shadow: 0 20px 50px rgba(0, 0, 0, .35), inset 0 1px 0 rgba(255, 255, 255, .28);
}

/* ---------- Buttons ---------- */
.btn-primary {
  background: var(--green); color: var(--navy); font: 800 16px 'Nunito', sans-serif;
  border: none; border-radius: 16px; padding: 14px 26px; box-shadow: 0 4px 0 var(--green-dark);
  cursor: pointer; transition: filter .1s, transform .1s, box-shadow .1s;
  display: inline-flex; align-items: center; justify-content: center; text-decoration: none;
}
.btn-primary:hover:not(:disabled) { filter: brightness(1.1); }
.btn-primary:active:not(:disabled) { transform: translateY(4px); box-shadow: none; }
.btn-primary:disabled { opacity: .5; cursor: not-allowed; }
.btn-primary.block { width: 100%; }
.btn-primary.small { padding: 8px 18px; font-size: 14px; border-radius: 12px; }

.btn-ghost {
  background: rgba(255, 255, 255, .1); color: #fff; font: 700 15px 'Nunito', sans-serif;
  border: 1px solid rgba(255, 255, 255, .25); border-radius: 16px; padding: 13px 22px;
  cursor: pointer; transition: background .2s; text-decoration: none; display: inline-flex; align-items: center;
}
.btn-ghost:hover:not(:disabled) { background: rgba(255, 255, 255, .16); }

/* ---------- Form fields ---------- */
.field { margin-bottom: 16px; }
.input-label { display: block; font-size: 13px; font-weight: 700; color: var(--muted); margin-bottom: 6px; }
.input-glass {
  width: 100%; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .25);
  border-radius: 14px; padding: 13px 16px; color: #fff; font: 15px 'Nunito', sans-serif;
}
.input-glass:focus { border: 2px solid var(--green); padding: 12px 15px; }
.input-glass::placeholder { color: rgba(185, 199, 230, .6); }
.check-row { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; font-size: 14px; color: var(--muted); }
.check-row input { width: 18px; height: 18px; accent-color: var(--green); }
.error-text { color: var(--again); font-size: 13px; font-weight: 700; margin-top: 6px; min-height: 0; }
.error-text:empty { display: none; }

/* ---------- Chip, progress, logo ---------- */
.chip {
  background: rgba(88, 204, 2, .18); border: 1px solid rgba(88, 204, 2, .5); color: var(--green-light);
  font-weight: 800; font-size: 13px; border-radius: 20px; padding: 6px 14px; display: inline-block;
}
.progress-track { background: var(--track); height: 10px; border-radius: 6px; width: 100%; overflow: hidden; }
.progress-fill { background: var(--green); height: 100%; width: 0; border-radius: 6px; transition: width .6s ease; }
.logo { font-size: 26px; font-weight: 900; letter-spacing: -.5px; color: #fff; text-decoration: none; }
.logo span { color: var(--green); }

/* ---------- Mascot (SVG sprite injected by ui.js) ---------- */
.mascot { position: absolute; z-index: 10; animation: float 3s ease-in-out infinite; }
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
.mascot-eye { transform-box: fill-box; transform-origin: center; animation: blink 5s infinite; }
@keyframes blink { 0%, 96%, 98%, 100% { transform: scaleY(1); } 97%, 99% { transform: scaleY(.1); } }
@media (prefers-reduced-motion: reduce) { .mascot, .mascot-eye { animation: none; } }

/* ---------- Top bar and footer ---------- */
.topbar { display: flex; justify-content: space-between; align-items: center; padding: 26px 48px; }
.topbar-right { display: flex; align-items: center; gap: 14px; }
.avatar {
