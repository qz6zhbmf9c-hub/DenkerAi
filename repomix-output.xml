<file path="public/js/practice.js">
// practice.html: one flashcard at a time, Anki-style rating buttons (keys 1-4).
import { api } from './api.js';
import { formatDelay, requireUser } from './ui.js';

await requireUser();

const collectionId = new URLSearchParams(location.search).get('collectionId');
if (!collectionId) location.replace('/app.html');

const $ = (id) => document.getElementById(id);
let queue = [];
let done = 0;
let current = null;
let answerShown = false;
let busy = false;

function updateCounters() {
  const count = (fn) => queue.filter(fn).length;
  $('cnt-new').textContent = count((c) => c.state === 'new');
  $('cnt-learn').textContent = count((c) => c.state === 'learning' || c.state === 'relearning');
  $('cnt-review').textContent = count((c) => c.state === 'review');
  const total = done + queue.length;
  const pct = total ? Math.round((done / total) * 100) : 100;
  $('count-text').textContent = `${done} of ${total}`;
  $('session-bar').style.width = pct + '%';
  $('session-track').setAttribute('aria-valuenow', pct);
}

function showCard() {
  updateCounters();
  if (queue.length === 0) {
    $('flashcard').hidden = true;
    $('counters').hidden = true;
    $('done').hidden = false;
    return;
  }
  current = queue[0];
  answerShown = false;
  const type = [current.partOfSpeech, current.gender].filter(Boolean).join(' · ');
  $('card-type').textContent = type.charAt(0).toUpperCase() + type.slice(1);
  $('card-german').textContent = current.german;
  $('card-english').textContent = current.english;
  $('card-example-de').textContent = current.exampleDe;
  $('card-example-en').textContent = current.exampleEn;
  $('answer').hidden = true;
  $('rating').hidden = true;
  $('show-wrap').hidden = false;
  $('flashcard').hidden = false;
  $('btn-show').focus();
}

function showAnswer() {
  if (!current || answerShown) return;
  answerShown = true;
  $('answer').hidden = false;
  $('show-wrap').hidden = true;
  current.delays.forEach((minutes, i) => ($('lbl-' + (i + 1)).textContent = formatDelay(minutes)));
  $('rating').hidden = false;
}

async function rate(rating) {
  if (!answerShown || busy) return;
  busy = true;
  try {
    const { card } = await api.post('/api/review', { cardId: current.id, rating });
    queue.shift();
    done += 1;
    // A card still in learning that is due within 20 minutes comes back this session.
    if ((card.state === 'learning' || card.state === 'relearning') && card.delayMinutes <= 20) {
      queue.push({ ...current, state: card.state, delays: card.delays });
    }
    showCard();
  } catch (err) {
    alert(err.message);
  } finally {
    busy = false;
  }
}

function speak() {
  if (!current || !('speechSynthesis' in window)) return;
  speechSynthesis.cancel();
  const utterance = new SpeechSynthesisUtterance(current.german);
  utterance.lang = 'de-DE';
  speechSynthesis.speak(utterance);
}

$('btn-show').addEventListener('click', showAnswer);
$('btn-speak').addEventListener('click', speak);
$('rating').addEventListener('click', (e) => {
  const button = e.target.closest('[data-rating]');
  if (button) rate(Number(button.dataset.rating));
});
document.addEventListener('keydown', (e) => {
  if (e.key === ' ' || e.key === 'Enter') {
    if (!answerShown && current && document.activeElement.tagName !== 'A') {
      e.preventDefault();
      showAnswer();
    }
  } else if (['1', '2', '3', '4'].includes(e.key)) rate(Number(e.key));
});

try {
  const data = await api.get(`/api/study?collectionId=${encodeURIComponent(collectionId)}`);
  $('col-title').textContent = data.collection.title;
  $('col-level').textContent = data.collection.level;
  queue = data.cards;
  showCard();
} catch {
  location.replace('/app.html');
}
</file>

<file path="public/js/test.js">
// test.html: 12 questions, then the server grades them and the AI estimates the level.
import { api } from './api.js';
import { el, hideLoading, requireUser, showLoading } from './ui.js';

await requireUser();

const { questions } = await api.get('/api/level/questions');
const answers = [];
let index = 0;
let chosen = null;

const sentence = document.getElementById('sentence');
const options = document.getElementById('options');
const next = document.getElementById('btn-next');

function render() {
  const q = questions[index];
  const pct = Math.round((index / questions.length) * 100);
  document.getElementById('progress-text').textContent = `Question ${index + 1} of ${questions.length}`;
  document.getElementById('progress-pct').textContent = `${pct}%`;
  document.getElementById('progress-bar').style.width = `${pct}%`;
  document.getElementById('progress-track').setAttribute('aria-valuenow', pct);

  sentence.textContent = q.q;
  options.replaceChildren(
    ...q.options.map((text, i) => {
      const option = el('button', { class: 'level-card', type: 'button', role: 'radio', 'aria-checked': 'false', text });
      option.addEventListener('click', () => choose(i));
      return option;
    })
  );
  chosen = null;
  next.disabled = true;
  next.textContent = index === questions.length - 1 ? 'Finish' : 'Next';
}

function choose(i) {
  chosen = i;
  [...options.children].forEach((node, n) => {
    node.classList.toggle('selected', n === i);
    node.setAttribute('aria-checked', String(n === i));
  });
  next.disabled = false;
}

async function submit(value) {
  answers.push(value); // -1 means skipped
  if (index < questions.length - 1) {
    index += 1;
    return render();
  }
  showLoading('Denki is checking your answers...');
  try {
    const result = await api.post('/api/level/estimate', { answers });
    hideLoading();
    document.getElementById('result-level').textContent = result.level;
    document.getElementById('result-reason').textContent = result.reason;
    document.getElementById('result-modal').classList.add('active');
    document.getElementById('btn-lets-go').focus();
  } catch (err) {
    hideLoading();
    alert(err.message);
  }
}

next.addEventListener('click', () => chosen !== null && submit(chosen));
document.getElementById('btn-skip').addEventListener('click', () => submit(-1));

// Keyboard: 1-4 select an answer, Enter continues.
document.addEventListener('keydown', (event) => {
  if (document.getElementById('result-modal').classList.contains('active')) return;
  if (['1', '2', '3', '4'].includes(event.key)) choose(Number(event.key) - 1);
  else if (event.key === 'Enter' && chosen !== null && document.activeElement.tagName !== 'BUTTON') submit(chosen);
});

render();
</file>

<file path="public/js/ui.js">
// Shared UI helpers: mascot sprite, top bar, loading overlay, page guards.
import { api } from './api.js';

// The mascot is defined once and reused with <use href="#mascot">.
// The eyes carry a class so the blink animation in style.css can target them.
const SPRITE = `
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <g id="mascot">
      <line x1="60" y1="14" x2="60" y2="28" stroke="#9CF04F" stroke-width="5" stroke-linecap="round"/>
      <circle cx="60" cy="12" r="8" fill="#FFD84D"/>
      <ellipse cx="60" cy="72" rx="46" ry="42" fill="#58CC02"/>
      <ellipse cx="60" cy="86" rx="30" ry="22" fill="#9CF04F" opacity=".55"/>
      <circle class="mascot-eye" cx="43" cy="62" r="13" fill="#fff"/>
      <circle class="mascot-eye" cx="77" cy="62" r="13" fill="#fff"/>
      <circle cx="45" cy="63" r="6" fill="#0A1730"/><circle cx="79" cy="63" r="6" fill="#0A1730"/>
      <path d="M48 86 Q60 98 72 86" stroke="#0A1730" stroke-width="4" fill="none" stroke-linecap="round"/>
    </g>
  </defs>
</svg>`;
document.body.insertAdjacentHTML('afterbegin', SPRITE);

/** Creates an element safely. Text always goes through textContent. */
export function el(tag, props = {}, children = []) {
  const node = document.createElement(tag);
  for (const [key, value] of Object.entries(props)) {
    if (key === 'text') node.textContent = value;
    else if (key === 'class') node.className = value;
    else if (key.startsWith('on')) node.addEventListener(key.slice(2), value);
    else node.setAttribute(key, value);
  }
  for (const child of [].concat(children)) if (child) node.append(child);
  return node;
}

/** Fills the top bar: Log in button, or level chip plus initial avatar. */
export function renderTopbar(user) {
  const bar = document.getElementById('topbar');
  const home = user ? '/app.html' : '/';
  bar.replaceChildren(el('a', { class: 'logo', href: home, 'aria-label': 'DenkerAI home' }, ['Denker', el('span', { text: 'AI' })]));
  const right = el('div', { class: 'topbar-right' });
  if (user) {
    if (user.level) right.append(el('span', { class: 'chip', text: user.level }));
    right.append(
      el('button', {
        class: 'avatar', type: 'button', title: 'Log out', 'aria-label': 'Log out',
        text: user.name.charAt(0).toUpperCase(),
        onclick: async () => {
          await api.post('/api/auth/logout').catch(() => {});
          location.href = '/';
        },
      })
    );
  } else {
    right.append(el('a', { class: 'btn-ghost', href: '/login.html', text: 'Log in' }));
  }
  bar.append(right);
}

export function showLoading(text) {
  document.getElementById('loading-text').textContent = text;
  document.getElementById('loading-modal').classList.add('active');
}
export const hideLoading = () => document.getElementById('loading-modal').classList.remove('active');

/** Shows (or clears) an error message in an element. */
export function setError(id, message = '') {
  document.getElementById(id).textContent = message;
}

/** Where a logged-in user should go next. */
export const nextPage = (user) => (user.level ? '/app.html' : '/level.html');

/** Returns the current user, or null when logged out. */
export async function fetchUser() {
  try {
    return (await api.get('/api/me')).user;
  } catch {
    return null;
  }
}

/** Guard for protected pages: redirects to login when there is no session. */
export async function requireUser() {
  const user = await fetchUser();
  if (!user) {
    location.replace('/login.html');
    return new Promise(() => {}); // never resolves: the page is leaving
  }
  renderTopbar(user);
  return user;
}

/** Turns a delay in minutes into a short label such as "10 min" or "4 days". */
export function formatDelay(minutes) {
  if (minutes < 60) return `${Math.max(1, Math.round(minutes))} min`;
  if (minutes < 1440) return `${Math.round(minutes / 60)} hr`;
  const days = minutes / 1440;
  if (days < 30) return `${Math.round(days)} ${Math.round(days) === 1 ? 'day' : 'days'}`;
  return `${(days / 30).toFixed(1).replace('.0', '')} mo`;
}

// The privacy page has no script of its own, so it just needs the top bar.
if (location.pathname.endsWith('privacy.html')) fetchUser().then(renderTopbar);
</file>

