/* ---------- Overlays ---------- */
.overlay {
  position: fixed; inset: 0; background: rgba(10, 23, 48, .8); backdrop-filter: blur(8px);
  display: none; align-items: center; justify-content: center; z-index: 100; padding: 20px;
}
.overlay.active { display: flex; }
.modal-box { padding: 40px; text-align: center; max-width: 420px; width: 100%; position: relative; }
