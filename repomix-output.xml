  display: flex; align-items: center; justify-content: center; font: 900 18px 'Nunito', sans-serif; cursor: pointer;
}
.footer { text-align: center; color: var(--muted); font-size: 14px; padding: 18px; }

/* ---------- Welcome page ---------- */
.welcome { display: grid; grid-template-columns: 1fr 400px; gap: 60px; padding: 30px 48px; max-width: 1200px; margin: 0 auto; align-items: center; }
.welcome .actions { display: flex; gap: 16px; flex-wrap: wrap; }
.card-wrap { position: relative; }
.card-wrap .mascot { right: -20px; top: -52px; width: 96px; }
.card-pad { padding: 32px; }
.narrow { max-width: 400px; margin: 60px auto 0; position: relative; padding: 0 20px; }
.narrow .mascot { right: 0; top: -70px; width: 96px; }

/* ---------- Level choice ---------- */
.level-wrap { max-width: 620px; margin: 40px auto 0; position: relative; padding: 0 20px; }
.level-wrap .mascot { right: 0; top: -70px; width: 84px; }
.level-card {
  width: 100%; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .22); color: #fff;
  border-radius: 20px; padding: 18px 24px; font: 800 20px 'Nunito', sans-serif; margin-bottom: 12px;
  cursor: pointer; display: flex; align-items: center; gap: 16px; transition: background .2s; text-align: left;
}
.level-card:hover { background: rgba(255, 255, 255, .13); }
.level-card.selected { background: rgba(88, 204, 2, .18); border: 2px solid var(--green); padding: 17px 23px; }
.level-card .code { width: 36px; color: var(--green-light); }

/* ---------- Level test ---------- */
.test-wrap { max-width: 760px; margin: 0 auto; padding: 20px; }
.row-between { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.test-card { padding: 38px; position: relative; margin-top: 28px; }
.test-card .mascot { right: -10px; top: -40px; width: 84px; }
.test-sentence { font-size: 38px; font-weight: 900; margin: 0 0 32px; line-height: 1.2; }
.test-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.test-grid .level-card { margin: 0; justify-content: center; font-size: 22px; text-align: center; }
.test-foot { margin-top: 28px; }

/* ---------- Dashboard ---------- */
.dash { max-width: 1000px; margin: 0 auto; padding: 0 48px; }
.stat-tiles, .collection-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.stat-tiles { margin-bottom: 40px; }
.stat-tile { padding: 18px 24px; }
.stat-value { font-size: 34px; font-weight: 900; }
.collection-card { padding: 20px 22px; }
.collection-card .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 8px; }
.collection-card .foot { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; }
.collection-card .progress-track { margin-top: 14px; }
.plus-card {
  border: 2px dashed rgba(255, 255, 255, .25); background: rgba(255, 255, 255, .05); min-height: 150px; color: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
  cursor: pointer; font: 800 16px 'Nunito', sans-serif; box-shadow: none;
}
.plus-card:hover { background: rgba(255, 255, 255, .1); }
.plus-badge {
  width: 58px; height: 58px; border-radius: 50%; background: var(--green); color: var(--navy);
  box-shadow: 0 4px 0 var(--green-dark); display: flex; align-items: center; justify-content: center; font-size: 30px; font-weight: 900;
}
.dash-mascot { position: fixed; right: 28px; bottom: 14px; width: 70px; }

/* ---------- Empty state / prompt bar ---------- */
.empty { margin-top: 90px; text-align: center; }
.prompt-wrap { position: relative; width: 100%; max-width: 760px; margin: 0 auto; }
.prompt-bar { height: 84px; border-radius: 42px; padding: 0 14px 0 34px; display: flex; align-items: center; }
